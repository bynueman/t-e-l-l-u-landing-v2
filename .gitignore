# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace-local npm caches and setup staging
/.npm-cache/
/%LOCALAPPDATA%/
/tellu-scaffold-temp/

# Local browser evidence, profiling output, and runtime logs
/artifacts/
/test-results/
/playwright-report/
*.log

# Unused scaffold icons; retain local copies without publishing default branding
/public/file.svg
/public/globe.svg
/public/next.svg
/public/vercel.svg
/public/window.svg

# Local archived initialization prompt points to a superseded repository
/TELLU-PHASE-1A.md
